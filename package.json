{
  "name": "yunji-sender",
  "type": "module",
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite dev",
    "deploy": "pnpm check && pnpm db:migrate:remote && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings --strict-vars=false",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web && tsc --noEmit -p test && tsc --noEmit -p e2e",
    "test": "vitest run && node --test scripts/test-markdown-performance.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "build": "vite build",
    "preview": "vite build && vite preview",
    "test:e2e": "node scripts/test-e2e.mjs",
    "check:release": "pnpm check && pnpm test:e2e"
  },
  "cloudflare": {
    "bindings": {
      "ADMIN_PASSWORD": {
        "description": "后台登录密码，用户名默认是 `admin`。请设置独立的强密码。"
      },
      "ENCRYPTION_KEY": {
        "description": "用于加密渠道凭证，必须是 32 字节随机密钥的 Base64 编码。用 `openssl rand -base64 32` 生成并妥善保存，丢失或更换后已存渠道凭证将无法解密。"
      }
    }
  },
  "dependencies": {
    "@cloudflare/kumo": "^2.14.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.104.3",
    "echarts": "^6.1.0",
    "hono": "^4.13.13",
    "i18next": "^26.4.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.0.21",
    "wouter": "^3.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/vitest-plugin": "^1.4.3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.110.0"
  },
  "license": "MIT"
}
