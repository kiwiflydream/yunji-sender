{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yunji-sender",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-16",
  "limits": { "cpu_ms": 1000 },
  "ratelimits": [
    { "name": "INBOUND_RATE_LIMIT", "namespace_id": "391701", "simple": { "limit": 300, "period": 60 } },
    { "name": "INBOUND_TOTAL_LIMIT", "namespace_id": "391702", "simple": { "limit": 1000, "period": 60 } },
    { "name": "STATS_RATE_LIMIT", "namespace_id": "391703", "simple": { "limit": 30, "period": 60 } }
  ],
  "observability": {
    "enabled": true
  },
  // The admin SPA (built by Vite into dist/client). Routes the Worker owns run
  // first, so /admin only serves the HTML shell after admin auth; everything
  // else (hashed bundles, Vite dev modules) is served as static assets.
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/", "/health", "/api/*", "/admin", "/admin/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yunji-sender",
      // Replace with the id printed by `wrangler d1 create yunji-sender` before deploying.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Remove this section (and run `pnpm cf-typegen`) to deploy without Queues;
  // deliveries then run in waitUntil and retries are picked up by the cron.
  "queues": {
    "producers": [
      {
        "binding": "DELIVERY_QUEUE",
        "queue": "yunji-sender-deliveries"
      }
    ],
    "consumers": [
      {
        "queue": "yunji-sender-deliveries",
        "max_batch_size": 5,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "max_concurrency": 2,
        "dead_letter_queue": "yunji-sender-deliveries-dlq"
      }
    ]
  },
  "triggers": {
    // Dispatch scheduled deliveries and retries, recover lost ones, purge old logs.
    "crons": ["* * * * *"]
  },
  "vars": {
    // Admin UI auth: "basic" (ADMIN_USERNAME + ADMIN_PASSWORD secret) or "access" (Cloudflare Access).
    "ADMIN_AUTH_MODE": "basic",
    "ADMIN_USERNAME": "admin"
  }
}
